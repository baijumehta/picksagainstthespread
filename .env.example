# ---- Required ----
# Any Postgres. Neon is the easiest fit for Vercel; the free tier is plenty.
# Use the POOLED connection string (Neon hostnames contain "-pooler").
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/picks?sslmode=require"

# Signs session cookies. Generate with:  openssl rand -base64 32
AUTH_SECRET="change-me"

# Public base URL, used to build magic-link sign-in URLs.
APP_URL="http://localhost:3000"

# ---- Spreads (The Odds API, free tier ~500 requests/month) ----
# https://the-odds-api.com  -- leave blank to enter every line by hand.
ODDS_API_KEY=""
# Which book to take the line from.
ODDS_BOOKMAKER="draftkings"

# ---- Score polling ----
# Shared secret for /api/cron/scores so only your scheduler can trigger it.
CRON_SECRET="change-me-too"

# ---- Email (optional in phase one) ----
# Without this, magic-link URLs are printed to the server console instead.
RESEND_API_KEY=""
MAIL_FROM="Picks Pool <picks@example.com>"
